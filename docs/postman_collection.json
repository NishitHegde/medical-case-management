{
	"info": {
		"_postman_id": "a918a28e-5b12-4c6e-92de-8e547372cf90",
		"name": "Jajal Medical - Case Management API",
		"description": "Postman collection covering all REST API operations for the Medical Case Management System with Laravel Sanctum authentication.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "case_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"    console.log('Token successfully captured');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@jajalmedical.com\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "2. Login (Viewer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"viewer@jajalmedical.com\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "3. Get Authenticated User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/user",
							"host": ["{{base_url}}"],
							"path": ["user"]
						}
					}
				},
				{
					"name": "4. Logout (Revoke Token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": ["{{base_url}}"],
							"path": ["logout"]
						}
					}
				}
			]
		},
		{
			"name": "Medical Cases",
			"item": [
				{
					"name": "1. List Cases (Paginated & Filtered)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases?page=1&per_page=10&status=Planning",
							"host": ["{{base_url}}"],
							"path": ["cases"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "per_page",
									"value": "10"
								},
								{
									"key": "status",
									"value": "Planning"
								},
								{
									"key": "case_number",
									"value": "",
									"disabled": true
								},
								{
									"key": "surgeon_name",
									"value": "",
									"disabled": true
								}
							]
						}
					}
				},
				{
					"name": "2. Create Case (Admin Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('case_id', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"case_number\": \"JM-API-{{$randomInt}}\",\n    \"patient_reference\": \"DUMMY-REF-{{$randomInt}}\",\n    \"surgeon_name\": \"Dr. Elena Rostova, MD\",\n    \"implant_type\": \"Titanium Cranial Reconstruction Plate\",\n    \"status\": \"Planning\",\n    \"priority\": \"High\",\n    \"surgery_date\": \"2026-11-20\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cases",
							"host": ["{{base_url}}"],
							"path": ["cases"]
						}
					}
				},
				{
					"name": "3. View Case Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases/{{case_id}}",
							"host": ["{{base_url}}"],
							"path": ["cases", "{{case_id}}"]
						}
					}
				},
				{
					"name": "4. Update Case (Admin Only)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"case_number\": \"JM-API-UPDATED\",\n    \"patient_reference\": \"DUMMY-REF-UPDATED\",\n    \"surgeon_name\": \"Dr. Elena Rostova, MD\",\n    \"implant_type\": \"Custom PEEK Cranial Implant\",\n    \"status\": \"Approved\",\n    \"priority\": \"High\",\n    \"surgery_date\": \"2026-11-25\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cases/{{case_id}}",
							"host": ["{{base_url}}"],
							"path": ["cases", "{{case_id}}"]
						}
					}
				},
				{
					"name": "5. Delete Case (Admin Only)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cases/{{case_id}}",
							"host": ["{{base_url}}"],
							"path": ["cases", "{{case_id}}"]
						}
					}
				}
			]
		}
	]
}
